# Copie para `.env.local` (desenvolvimento) ou cadastre no painel da hospedagem (produção).
# Nunca commite valores reais: só este arquivo de exemplo vai pro repositório.
#
# Variáveis NEXT_PUBLIC_* são embutidas no código durante o `npm run build` —
# alterar uma delas exige um novo build/deploy pra valer.

# --- Obrigatória ---------------------------------------------------------------
# URL base da Sunset.API, terminando em /api/v1.
# Dev:  http://localhost:5256/api/v1
# Prod: precisa ser HTTPS (o site em https://sunsetsss.com não chama API em http).
#       API atual no Render: https://sunsetapi.onrender.com/api/v1
# Sem esta variável o padrão é https://localhost:7044/api/v1 e nada funciona em produção.
NEXT_PUBLIC_API_URL=http://localhost:5256/api/v1

# Origem pública do site (metadataBase, sitemap.xml e robots.txt). Padrão: https://sunsetsss.com.
# Só defina pra apontar pra outro host (ex.: staging).
# NEXT_PUBLIC_SITE_URL=https://sunsetsss.com

# --- Google --------------------------------------------------------------------
# Chave da Google Maps API (mapa do local e seletor de posição no upload).
# Em produção, restrinja a chave por referenciador HTTP a https://sunsetsss.com/*.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ID de cliente OAuth (login com Google). Em produção, cadastre https://sunsetsss.com
# em "Origens JavaScript autorizadas" desse cliente.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Anúncios (opcional) -------------------------------------------------------
# Deixe vazio pra não exibir anúncios.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_IN_FEED_SLOT_ID=
NEXT_PUBLIC_ADSENSE_IN_FEED_LAYOUT_KEY=

# --- Logs (opcional) -----------------------------------------------------------
# debug | info | warn | error. Padrão: debug em dev, warn em produção.
# NEXT_PUBLIC_LOG_LEVEL=warn
